# ─── Next.js (frontend) ───────────────────────────────────────────────────────

# REQUIRED: URL of your running GEE Python backend.
# Local dev: http://localhost:8000
# Production: https://your-gee-backend.run.app (Cloud Run, etc.)
GEE_BACKEND_URL=http://localhost:8000

# OPTIONAL: Supabase — only needed for database features (projects/runs persistence).
# Leave blank to run in mock/local mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
